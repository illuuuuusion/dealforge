# Read by docker compose (interpolation) or by Node via --env-file=.env (see README).
PORT=3000
HOST=127.0.0.1
# Mandatory outside demo mode on localhost (>=16 characters), also for docker compose.
APP_PASSWORD=
# Optional; if omitted, random at each restart (existing sessions expire).
SESSION_SECRET=
# Set to the real public HTTPS URL for deployment.
APP_ORIGIN=http://localhost:3000
# Host defaults match the compose ports; inside compose these are set automatically.
DATABASE_URL=postgres://dealforge:dealforge@127.0.0.1:55432/dealforge
REDIS_URL=redis://127.0.0.1:56379
DEMO_MODE=true
ENABLE_SCHEDULER=false
POLL_INTERVAL_SECONDS=300
# Fast watchlists: own schedule, only for these sources (see ADR 001). Empty = no fast polling.
FAST_PROVIDERS=
FAST_POLL_INTERVAL_SECONDS=60
# Contact for push services (VAPID). The key pair is generated once and stored in the database.
VAPID_SUBJECT=mailto:dealforge@localhost
# Comma list of sources with a documented GO (docs/decisions/001-provider-policy.md), e.g. ebay.
# Empty = no live provider calls at all.
APPROVED_PROVIDERS=
# Hard budget gate per provider: UTC day, calendar month, one search filter per day.
PROVIDER_DAILY_CALL_LIMIT=200
PROVIDER_MONTHLY_CALL_LIMIT=5000
QUERY_DAILY_CALL_LIMIT=100
# Official eBay Buy Browse OAuth application credentials.
EBAY_APP_ID=
EBAY_CLIENT_SECRET=
# Unofficial third-party Kleinanzeigen Agent, only after permission / ToS review.
KLAZ_API_KEY=
KLAZ_LOCATION_ID=
KLAZ_RADIUS_KM=
# Facebook Marketplace remains import-only pending provider vetting.
APIFY_TOKEN=
FB_ACTOR_ID=
FB_ACTOR_INPUT_JSON=
