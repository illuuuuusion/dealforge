# Environment loaded by Node.js using --env-file=.env (see README).
PORT=3000
HOST=127.0.0.1
# Mandatory before public deployment (>=16 characters).
APP_PASSWORD=
# Optional; if omitted, random at each restart (existing sessions expire).
SESSION_SECRET=
# Set to the real public HTTPS URL for deployment.
APP_ORIGIN=http://localhost:3000
DB_PATH=./data/dealforge.sqlite
DEMO_MODE=true
ENABLE_SCHEDULER=false
POLL_INTERVAL_SECONDS=300
# Official eBay Buy Browse OAuth application credentials.
EBAY_APP_ID=
EBAY_CLIENT_SECRET=
# Unofficial third-party Kleinanzeigen Agent, only after permission / ToS review.
KLAZ_API_KEY=
KLAZ_LOCATION_ID=
KLAZ_RADIUS_KM=
# Facebook Marketplace remains import-only pending provider vetting.
APIFY_TOKEN=
FB_ACTOR_ID=
FB_ACTOR_INPUT_JSON=
